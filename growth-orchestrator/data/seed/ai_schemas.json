{
  "schemas": {
    "reply_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "confidence",
        "interest_level",
        "follow_up_date",
        "referred_contact",
        "qualification",
        "suggested_action",
        "needs_human_review",
        "evidence"
      ],
      "properties": {
        "label": {
          "enum": [
            "interested",
            "info_request",
            "objection",
            "not_now",
            "wrong_person",
            "unsubscribe",
            "out_of_office",
            "auto_reply",
            "hostile",
            "ambiguous",
            "mixed_signals",
            "prompt_injection",
            "empty_or_truncated"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "interest_level": {
          "enum": [
            "high",
            "medium",
            "low",
            "none",
            "unclear"
          ]
        },
        "follow_up_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "YYYY-MM-DD",
          "note": "only when the reply states an explicit date; must be after the reply date"
        },
        "referred_contact": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "name",
            "email"
          ],
          "note": "only people/emails literally present in the reply"
        },
        "qualification": {
          "type": "object",
          "required": [
            "team_size",
            "current_solution",
            "timeline_months",
            "countries",
            "pain_points",
            "budget_signal"
          ],
          "properties": {
            "team_size": {
              "type": [
                "integer",
                "null"
              ]
            },
            "current_solution": {
              "enum": [
                "bank_cards",
                "spreadsheets",
                "other_fintech",
                "erp_module",
                "manual_process",
                null
              ]
            },
            "timeline_months": {
              "type": [
                "integer",
                "null"
              ]
            },
            "countries": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            },
            "pain_points": {
              "type": "array",
              "items": {
                "enum": [
                  "reimbursements",
                  "reconciliation",
                  "spend_control",
                  "travel",
                  "multi_currency",
                  "suppliers"
                ]
              }
            },
            "budget_signal": {
              "enum": [
                "has_budget",
                "no_budget",
                null
              ]
            }
          }
        },
        "suggested_action": {
          "enum": [
            "contact",
            "wait",
            "enrich",
            "escalate_human",
            "handoff_ae",
            "suppress",
            "no_action"
          ],
          "note": "advisory only; the system derives the action from `label`"
        },
        "needs_human_review": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "maxLength": 200,
          "note": "verbatim quote from the reply's own text (not the quoted thread)"
        }
      }
    },
    "personalization_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "subject",
        "body",
        "claims",
        "personalized"
      ],
      "properties": {
        "language": {
          "enum": [
            "es",
            "pt",
            "en"
          ]
        },
        "subject": {
          "type": "string",
          "maxLength": 70
        },
        "body": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "fact_id"
            ]
          }
        },
        "personalized": {
          "type": "boolean"
        }
      }
    }
  },
  "reply_rules": {
    "V001": {
      "name": "NOT_JSON",
      "verdict": "reject_retry",
      "description": "empty, truncated or prose output"
    },
    "V002": {
      "name": "SCHEMA_MISSING_OR_EXTRA_FIELD",
      "verdict": "reject_retry",
      "description": "required field missing or unknown field present"
    },
    "V003": {
      "name": "SCHEMA_BAD_VALUE",
      "verdict": "reject_retry",
      "description": "value outside its enum / type / format"
    },
    "V005": {
      "name": "CONFIDENCE_OUT_OF_RANGE",
      "verdict": "reject_retry",
      "description": "confidence not in [0,1]"
    },
    "V006": {
      "name": "EVIDENCE_NOT_IN_TEXT",
      "verdict": "reject_escalate",
      "description": "evidence quote is not in the reply's own text"
    },
    "V007": {
      "name": "REFERRAL_NOT_IN_TEXT",
      "verdict": "reject_escalate",
      "description": "referred name/email not literally in the reply"
    },
    "V008": {
      "name": "DATE_NOT_SUPPORTED",
      "verdict": "reject_escalate",
      "description": "follow_up_date not stated in the reply, or not in the future"
    },
    "V009": {
      "name": "QUALIFICATION_NOT_SUPPORTED",
      "verdict": "reject_escalate",
      "description": "extracted team size / country / budget / timeline not in the text"
    },
    "V010": {
      "name": "ACTION_LABEL_MISMATCH",
      "verdict": "override_rule",
      "description": "suggested_action disagrees with the label map; label map wins"
    },
    "V011": {
      "name": "LOW_CONFIDENCE",
      "verdict": "escalate_low_confidence",
      "description": "confidence < 0.75: never auto-act"
    },
    "V012": {
      "name": "INJECTION_FOLLOWED",
      "verdict": "reject_escalate",
      "description": "reply contains instructions to the system but label is not prompt_injection"
    },
    "G001": {
      "name": "OPT_OUT_GUARD",
      "verdict": "override_rule",
      "description": "opt-out wording in the reply forces suppress, whatever the model says"
    }
  },
  "draft_rules": {
    "P001": {
      "name": "NOT_JSON",
      "verdict": "reject_retry"
    },
    "P002": {
      "name": "SCHEMA",
      "verdict": "reject_retry"
    },
    "P003": {
      "name": "CLAIM_WITHOUT_FACT_ID",
      "verdict": "fallback_generic"
    },
    "P004": {
      "name": "FACT_NOT_PROVIDED",
      "verdict": "fallback_generic"
    },
    "P005": {
      "name": "FACT_NOT_USABLE",
      "verdict": "fallback_generic"
    },
    "P006": {
      "name": "CLAIM_UNSUPPORTED_BY_FACT",
      "verdict": "fallback_generic"
    },
    "P007": {
      "name": "FORBIDDEN_CLAIM",
      "verdict": "fallback_generic"
    },
    "P008": {
      "name": "MISSING_UNSUBSCRIBE_FOOTER",
      "verdict": "fallback_generic"
    },
    "P009": {
      "name": "BODY_TOO_LONG",
      "verdict": "fallback_generic"
    },
    "P010": {
      "name": "WRONG_LANGUAGE",
      "verdict": "fallback_generic"
    },
    "P011": {
      "name": "PERSONALIZED_WITHOUT_USABLE_FACTS",
      "verdict": "fallback_generic"
    },
    "P012": {
      "name": "SUBJECT_TOO_LONG",
      "verdict": "fallback_generic"
    },
    "P013": {
      "name": "CLAIM_NOT_IN_BODY",
      "verdict": "fallback_generic"
    },
    "P014": {
      "name": "TOO_MANY_CLAIMS",
      "verdict": "fallback_generic"
    }
  },
  "label_to_action": {
    "interested": "handoff_ae",
    "info_request": "escalate_human",
    "objection": "escalate_human",
    "not_now": "wait",
    "wrong_person": "enrich",
    "unsubscribe": "suppress",
    "out_of_office": "wait",
    "auto_reply": "no_action",
    "hostile": "suppress",
    "ambiguous": "escalate_human",
    "mixed_signals": "suppress",
    "prompt_injection": "escalate_human",
    "empty_or_truncated": "escalate_human"
  },
  "opt_out_labels": [
    "hostile",
    "mixed_signals",
    "unsubscribe"
  ],
  "confidence_threshold_auto_act": 0.75,
  "verdicts": {
    "accept": "use the output",
    "accept_with_warning": "use it, log the warning",
    "reject_retry": "invalid structure: retry once, then escalate_human / generic template",
    "reject_escalate": "output unsupported by the text: escalate_human, no retry",
    "escalate_low_confidence": "valid but below threshold: escalate_human",
    "override_rule": "deterministic rule decides the action; model output only informs",
    "fallback_generic": "draft failed validation: send the approved generic template"
  },
  "principle": "the model proposes; deterministic code disposes"
}
