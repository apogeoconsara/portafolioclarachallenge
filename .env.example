# Environment variables for the Growth Orchestrator (Clara challenge).
# Set them in Netlify (Site configuration -> Environment variables) or in your shell. NEVER commit real values.
# They are read server-side only (Netlify Function / Python CLI), never by the browser.

ANTHROPIC_API_KEY=        # live AI panel + live eval (netlify/functions/orchestrator-llm.mjs, python -m orchestrator --live)
ORCH_MODEL=               # optional model override (default: claude-haiku-4-5-20251001)
ORCH_WEBHOOK_SECRET=      # optional: HMAC secret for `python -m orchestrator serve`
